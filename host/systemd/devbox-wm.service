[Unit]
Description=Window manager of screen :1 (openbox)
Requires=devbox-vnc.service
After=devbox-vnc.service

[Service]
Environment=DISPLAY=:1
ExecStartPre=/bin/sh -c 'for i in $(seq 1 50); do [ -S /tmp/.X11-unix/X1 ] && exit 0; sleep 0.2; done; exit 1'
ExecStart=/usr/bin/openbox
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
