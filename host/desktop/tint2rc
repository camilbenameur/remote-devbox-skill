# Bottom bar of the noVNC screen (devbox): Chrome icon, open windows, clock.
# Installed by 20-user-setup.sh.

# Background 1: the bar
rounded = 0
border_width = 0
background_color = #1f2329 100
border_color = #000000 0

# Background 2: active window
rounded = 4
border_width = 0
background_color = #3b4252 100
border_color = #000000 0

panel_items = LTC
panel_size = 100% 38
panel_margin = 0 0
panel_padding = 6 4 8
panel_position = bottom center horizontal
panel_layer = top
panel_background_id = 1
wm_menu = 1
panel_dock = 0
autohide = 0
strut_policy = follow_size

launcher_padding = 4 4 6
launcher_background_id = 0
launcher_icon_size = 28
launcher_icon_theme = hicolor
launcher_tooltip = 1
launcher_item_app = @HOME@/.local/share/applications/devbox-chrome.desktop

taskbar_mode = single_desktop
taskbar_padding = 4 2 4
taskbar_background_id = 0
taskbar_name = 0

task_text = 1
task_icon = 1
task_centered = 0
task_maximum_size = 260 30
task_padding = 6 3 6
task_font_color = #e5e9f0 100
task_active_font_color = #ffffff 100
task_background_id = 0
task_active_background_id = 2
mouse_left = toggle_iconify
mouse_middle = close

time1_format = %H:%M
clock_font_color = #e5e9f0 100
clock_padding = 8 0
clock_background_id = 0
